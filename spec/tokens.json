{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "RegulonDB MG Design System — design tokens. Single source of truth. Hex values transcribed from the official RegulonDB palette PDF; semantic mappings derived per the brand brief. Imported in three places: spec/assets/tokens.css, lib/src/styles/tokens.css, and inlined in lib/showcase.html. Run `node scripts/build-tokens.mjs` after editing.",
  "$version": "1.0.0",
  "color": {
    "blue": {
      "1": { "$value": "#1F3D4E", "$type": "color", "$description": "Brand identity dark. Headers, H1, surface-header." },
      "2": { "$value": "#32617D", "$type": "color", "$description": "Primary action. Links, primary CTA, active tab." },
      "3": { "$value": "#3D779B", "$type": "color", "$description": "Hover, focus ring." },
      "4": { "$value": "#72A7C7", "$type": "color", "$description": "Soft highlight, info." },
      "5": { "$value": "#D5E2EA", "$type": "color", "$description": "Soft surface, section background." }
    },
    "grey": {
      "1": { "$value": "#373737", "$type": "color", "$description": "Body text." },
      "2": { "$value": "#666666", "$type": "color", "$description": "Secondary text." },
      "3": { "$value": "#999999", "$type": "color", "$description": "Tertiary text, placeholders, coordinates." },
      "4": { "$value": "#D5D5D7", "$type": "color", "$description": "Borders, dividers." },
      "5": { "$value": "#F4F5F5", "$type": "color", "$description": "Sunken surface." }
    },
    "white": { "$value": "#FFFFFF", "$type": "color" },
    "black": { "$value": "#000000", "$type": "color" },
    "accent":      { "$value": "#C98528", "$type": "color", "$description": "Secondary CTA, predicted/computational evidence, divergent gene arrows." },
    "accentLight": { "$value": "#D2A769", "$type": "color", "$description": "Border of accent buttons, predicted-light." },
    "postit":      { "$value": "#FFF8A6", "$type": "color", "$description": "Curator notes, search highlight <mark>." },
    "error":       { "$value": "#C93A1D", "$type": "color", "$description": "Repression, weak evidence, errors." },

    "evidence": {
      "curated":    { "$value": "{color.blue.2}", "$type": "color" },
      "curatedBg":  { "$value": "#E1E9EE",        "$type": "color", "$description": "blue-2 @ 12% on white" },
      "curatedFg":  { "$value": "#214557",        "$type": "color" },
      "predicted":  { "$value": "{color.accent}", "$type": "color" },
      "predictedBg":{ "$value": "#F8EEDD",        "$type": "color", "$description": "accent @ 12% on white" },
      "predictedFg":{ "$value": "#6E481A",        "$type": "color" },
      "ht":         { "$value": "#7C5295",        "$type": "color" },
      "htBg":       { "$value": "#ECE5F0",        "$type": "color", "$description": "ht @ 12% on white" },
      "htFg":       { "$value": "#4B2F5C",        "$type": "color" },
      "weak":       { "$value": "{color.error}",  "$type": "color" },
      "weakBg":     { "$value": "#F7E1DC",        "$type": "color", "$description": "error @ 12% on white" },
      "weakFg":     { "$value": "#7A2412",        "$type": "color" }
    },

    "object": {
      "gene":     { "$value": "#2F6B48", "$type": "color" },
      "operon":   { "$value": "#7A4A1E", "$type": "color" },
      "tf":       { "$value": "#6B2F64", "$type": "color" },
      "regulon":  { "$value": "#1A4D6B", "$type": "color" },
      "promoter": { "$value": "#A14522", "$type": "color" },
      "dataset":  { "$value": "#3D4A7A", "$type": "color" }
    }
  },

  "surface": {
    "canvas":  { "$value": "{color.white}",   "$type": "color" },
    "raised":  { "$value": "{color.white}",   "$type": "color" },
    "sunken":  { "$value": "{color.grey.5}",  "$type": "color" },
    "section": { "$value": "{color.blue.5}",  "$type": "color" },
    "note":    { "$value": "{color.postit}",  "$type": "color" },
    "header":  { "$value": "{color.blue.1}",  "$type": "color" }
  },

  "text": {
    "primary":   { "$value": "{color.grey.1}", "$type": "color" },
    "secondary": { "$value": "{color.grey.2}", "$type": "color" },
    "tertiary":  { "$value": "{color.grey.3}", "$type": "color" },
    "onDark":    { "$value": "{color.white}",  "$type": "color" },
    "link":      { "$value": "{color.blue.2}", "$type": "color" },
    "linkHover": { "$value": "{color.blue.3}", "$type": "color" },
    "title":     { "$value": "{color.blue.1}", "$type": "color" },
    "error":     { "$value": "{color.error}",  "$type": "color" }
  },

  "border": {
    "default": { "$value": "{color.grey.4}", "$type": "color" },
    "subtle":  { "$value": "#E8EAEC",        "$type": "color" },
    "strong":  { "$value": "{color.grey.3}", "$type": "color" },
    "focus":   { "$value": "{color.blue.3}", "$type": "color" }
  },

  "darkMode": {
    "surfaceCanvas":  { "$value": "#0E1A22", "$type": "color", "$description": "Body bg in dark, derived from blue-1." },
    "surfaceRaised":  { "$value": "#152834", "$type": "color" },
    "surfaceSunken":  { "$value": "#0B141A", "$type": "color" },
    "surfaceSection": { "$value": "#1A2D38", "$type": "color" },
    "surfaceNote":    { "$value": "#5A4F00", "$type": "color", "$description": "Inverted postit; readable yellow tint." },
    "surfaceHeader":  { "$value": "#0A141A", "$type": "color" },

    "textPrimary":    { "$value": "#E6EEF3", "$type": "color" },
    "textSecondary":  { "$value": "#A7B4BB", "$type": "color" },
    "textTertiary":   { "$value": "#7A8890", "$type": "color" },
    "textLink":       { "$value": "#9CC5DC", "$type": "color" },
    "textLinkHover":  { "$value": "#BFDCEC", "$type": "color" },
    "textTitle":      { "$value": "#E6EEF3", "$type": "color" },

    "borderDefault":  { "$value": "#2A3D48", "$type": "color" },
    "borderSubtle":   { "$value": "#1E2E38", "$type": "color" },
    "borderStrong":   { "$value": "#3B5260", "$type": "color" },

    "evidenceCuratedBg":   { "$value": "#1B2E3A", "$type": "color" },
    "evidenceCuratedFg":   { "$value": "#9CC5DC", "$type": "color" },
    "evidencePredictedBg": { "$value": "#3A2C15", "$type": "color" },
    "evidencePredictedFg": { "$value": "#E3B977", "$type": "color" },
    "evidenceHtBg":        { "$value": "#2B2338", "$type": "color" },
    "evidenceHtFg":        { "$value": "#C7B0E8", "$type": "color" },
    "evidenceWeakBg":      { "$value": "#3A1F18", "$type": "color" },
    "evidenceWeakFg":      { "$value": "#EF7D67", "$type": "color" },

    "shadowXs": { "$value": "0 1px 2px rgba(0, 0, 0, 0.40)",  "$type": "shadow" },
    "shadowSm": { "$value": "0 2px 6px rgba(0, 0, 0, 0.50)",  "$type": "shadow" },
    "shadowMd": { "$value": "0 8px 24px rgba(0, 0, 0, 0.55)", "$type": "shadow" }
  },

  "typography": {
    "fontFamily": {
      "sans":     { "$value": "Arial, \"Helvetica Neue\", Helvetica, sans-serif",        "$type": "fontFamily" },
      "citation": { "$value": "\"Times New Roman\", Times, Georgia, serif",              "$type": "fontFamily" },
      "mono":     { "$value": "\"Courier New\", ui-monospace, \"SF Mono\", Menlo, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "h1":      { "$value": "1.5rem",    "$type": "dimension", "$description": "24 px" },
      "h2":      { "$value": "1.375rem",  "$type": "dimension", "$description": "22 px" },
      "h3":      { "$value": "1.25rem",   "$type": "dimension", "$description": "20 px" },
      "h4":      { "$value": "1.125rem",  "$type": "dimension", "$description": "18 px" },
      "bodyLg":  { "$value": "1rem",      "$type": "dimension", "$description": "16 px — relevant body" },
      "body":    { "$value": "0.875rem",  "$type": "dimension", "$description": "14 px — normal body" },
      "mono":    { "$value": "0.8125rem", "$type": "dimension", "$description": "13 px — sequence / code" },
      "monoSm":  { "$value": "0.75rem",   "$type": "dimension", "$description": "12 px — coordinates" }
    },
    "lineHeight": {
      "h1":     { "$value": 1.25, "$type": "number" },
      "h2":     { "$value": 1.3,  "$type": "number" },
      "h3":     { "$value": 1.35, "$type": "number" },
      "h4":     { "$value": 1.4,  "$type": "number" },
      "bodyLg": { "$value": 1.6,  "$type": "number" },
      "body":   { "$value": 1.55, "$type": "number" },
      "mono":   { "$value": 1.55, "$type": "number" },
      "monoSm": { "$value": 1.4,  "$type": "number" }
    }
  },

  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "7":  { "$value": "32px", "$type": "dimension" },
    "8":  { "$value": "40px", "$type": "dimension" },
    "9":  { "$value": "48px", "$type": "dimension" },
    "10": { "$value": "64px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "6px",   "$type": "dimension" },
    "lg":   { "$value": "10px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },

  "shadow": {
    "xs": { "$value": "0 1px 2px rgba(31, 61, 78, 0.06)",  "$type": "shadow" },
    "sm": { "$value": "0 2px 6px rgba(31, 61, 78, 0.10)",  "$type": "shadow" },
    "md": { "$value": "0 8px 24px rgba(31, 61, 78, 0.14)", "$type": "shadow" }
  },

  "motion": {
    "easeStandard":  { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
    "durMicro":      { "$value": "120ms", "$type": "duration" },
    "durStandard":   { "$value": "200ms", "$type": "duration" },
    "durPage":       { "$value": "320ms", "$type": "duration" }
  },

  "layout": {
    "containerMax":     { "$value": "1280px", "$type": "dimension" },
    "containerWide":    { "$value": "1400px", "$type": "dimension" },
    "sidebarWidth":     { "$value": "280px",  "$type": "dimension" },
    "rightPanelWidth":  { "$value": "360px",  "$type": "dimension" },
    "headerHeight":     { "$value": "56px",   "$type": "dimension" },
    "subheaderHeight":  { "$value": "44px",   "$type": "dimension" }
  },

  "breakpoint": {
    "sm": { "$value": "640px",  "$type": "dimension" },
    "md": { "$value": "768px",  "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" }
  }
}
